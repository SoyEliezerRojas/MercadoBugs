# Copy this file to web/.env.local when Supabase is configured in Phase 2.
# These are the only Supabase values allowed in the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-local-publishable-key

# Optional: change this only if the GitHub repository has another name.
VITE_BASE_PATH=/MercadoBugs/
